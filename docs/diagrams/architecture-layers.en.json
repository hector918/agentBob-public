  "cards": [
    {
      "dot": "cyan",
      "title": "Mechanism vs policy",
      "items": [
        "What the system can do sinks into pluggable modules",
        "How a conversation is orchestrated floats up into flows"
      ]
    },
    {
      "dot": "emerald",
      "title": "The trunk is a match-maker, not a mediator",
      "items": [
        "Providers register once at Start; consumers Require once at wiring",
        "After that the call is point-to-point — the spine is off the hot path"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries that fail loudly",
      "items": [
        "leaf modules never import each other; heartwood is the single exception",
        "A sidecar carries its own go.mod, so it cannot reach contract at all"
      ]
    }
  ]
