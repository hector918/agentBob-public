# WordPress / WooCommerce 站点凭证 —— 凭证管理 vault 模板（不是进程 .env！）
#
# 一个站点 = 一份命名凭证。把本文件复制到：
#     ~/.bob/credentials/<name>.env      (<name> 自取，如 wp-shop-a；小写字母/数字/-/_)
# 填好下面字段，然后在 permissions.yaml 给用它的 principal 发：
#     tool:use:woocommerce
#     tool:use:wordpress_content
#     credential:use:<name>             # ← 没这行工具会报"没有授权给你的 wordpress 凭证"
# 多个站点 = 多份这样的文件 + 多个 member 各授一套（一身份只该有一套同 kind）。
#
# 文件格式：第一行必须是 kind=；key=value，# 起头是注释；详见 docs/wordpress.md。

kind=wordpress

# 站点根，不带 /wp-json 后缀，须 HTTPS：
base_url=https://shop.example.com

# WooCommerce consumer key/secret（只认证 /wp-json/wc/… 路由）。
# 想给 Woo 上独立 scoped 钥匙（如只读）就填这对；纯发博客/页面可留空。
woo_ck=
woo_cs=

# WP 应用程序密码（用户名 + 生成串）。管理员的 app password 能认证 core + Woo 两边，
# 所以最省配法 = 只填 base_url + wp_user + wp_pass 一组，两个工具都能用。
wp_user=
wp_pass=
