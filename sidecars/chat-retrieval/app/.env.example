# ===========================================================================
# 三个重点(up.sh 新部署时只问这三个;其余项默认即可,需要时手改)
# ===========================================================================
# 1) 数据库 DSN。host == postgres → up.sh 起内置库;其它 host → 外部库(只起 app)。
#    内置库密码须与 docker-compose.yml 的 POSTGRES_PASSWORD 一致。
DATABASE_URL=postgres://chat:chat_password_change_me@postgres:5432/chatdata

# 2) Embedding 服务 REST API(OpenAI 兼容 /v1/embeddings;llama.cpp --embeddings)。
#    host == host.docker.internal/localhost → up.sh 在本机起 llama-server;其它 → 外部。
EMBEDDER_BASE_URL=http://host.docker.internal:8080/v1

# 3) Reranker 服务 REST API(llama.cpp /rerank,Cohere/Jina 风格)。
RERANKER_BASE_URL=http://host.docker.internal:8081

# up.sh 按你选的 internal/external 自动设这两个标记(不从地址猜,tunnel 在 127.0.0.1
# 也能正确判为外置):1 = 本脚本起本机 llama-server;0 = 只连上面的 URL(外部/tunnel)。
EMBEDDER_MANAGED=0
RERANKER_MANAGED=0

# ===========================================================================
# 次要
# ===========================================================================
DB_POOL_MIN=5
DB_POOL_MAX=20

# 单模型 llama-server 忽略 model 字段(仅作日志对齐);真正路由靠上面的 URL。
EMBEDDER_API_KEY=dummy
EMBEDDER_MODEL=qwen3-embedding-0.6b-q8_0.gguf
EMBEDDER_DIMENSIONS=1024            # ⚠ 冻结依赖:换模型/维度=历史向量全作废重算
EMBEDDER_TIMEOUT=120.0

RERANKER_API_KEY=dummy
RERANKER_MODEL=qwen3-reranker-0.6b-q8_0.gguf
RERANKER_TIMEOUT=120.0
RERANKER_ENABLED=true               # false = 跳过 rerank,直接用向量分
RERANK_BATCH_SIZE=32

# 应用
LOG_LEVEL=info
# 数据面鉴权: 设置后 /messages* 和 /retrieve 要求请求头 X-API-Key 一致
# (bob 侧 = config 的 retrieval.api_key)。空 = 不鉴权。
API_KEY=

# 检索默认参数
DEFAULT_CANDIDATES=30
DEFAULT_TOP_N=10
